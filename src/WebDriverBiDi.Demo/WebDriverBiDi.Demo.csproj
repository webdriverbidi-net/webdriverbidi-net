<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebDriverBiDi.Demo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDriverBiDi\WebDriverBiDi.csproj" />
    <ProjectReference Include="..\WebDriverBiDi.Browsers\WebDriverBiDi.Browsers.csproj" />
    <ProjectReference Include="..\WebDriverBiDi.Extensions\WebDriverBiDi.Extensions.csproj" />
    <ProjectReference Include="..\WebDriverBiDi.DemoWebSite\WebDriverBiDi.DemoWebSite.csproj" />
  </ItemGroup>

  <!-- The element state library used by ElementStateInspector, loaded into the page as a preload script. -->
  <ItemGroup>
    <EmbeddedResource Include="$(ProjectDir)../../third_party/acquiescence/acquiescence.browser.js">
      <Visible>False</Visible>
      <LogicalName>acquiescence-library</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
