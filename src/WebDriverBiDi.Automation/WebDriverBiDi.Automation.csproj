<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <RootNamespace>WebDriverBiDi.Automation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../WebDriverBiDi.snk</AssemblyOriginatorKeyFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>

    <!-- Not yet production quality; becomes packable when its roadmap phase is complete. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>WebDriverBiDi.Automation</PackageId>
    <Authors>WebDriverBiDi.NET Committers</Authors>
    <Company>WebDriverBiDi.NET Committers</Company>
    <Title>WebDriver BiDirectional Client Library - Browser Automation</Title>
    <Description>A high-level browser automation API with automatic waiting, built on the WebDriver BiDi .NET client library.</Description>
    <PackageTags>webdriver;bidi;browser-automation;testing;auto-wait</PackageTags>
    <PackageProjectUrl>https://github.com/webdriverbidi-net/webdriverbidi-net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/webdriverbidi-net/webdriverbidi-net</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink maps only the sources in source control; the SDK generates others (AssemblyInfo,
         GlobalUsings). Embedding them puts every source a debugger may ask for in the symbol package. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WebDriverBiDi/WebDriverBiDi.csproj" />
    <ProjectReference Include="../WebDriverBiDi.Browsers/WebDriverBiDi.Browsers.csproj" />
    <ProjectReference Include="../WebDriverBiDi.Extensions/WebDriverBiDi.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../.stylecop.json" Link=".stylecop.json" />
    <AdditionalFiles Include="../../WebDriverBiDi.snk" />
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ProjectDir)../../third_party/acquiescence/acquiescence.browser.js">
      <Visible>False</Visible>
      <LogicalName>acquiescence-library</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
