<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../WebDriverBiDi.snk</AssemblyOriginatorKeyFile>

    <!-- Do not produce a separate package - output of this project is included in WebDriverBiDi.Analyzers -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <RootNamespace>WebDriverBiDi.Analyzers</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Built once per Roslyn variant by WebDriverBiDi.Analyzers.csproj's packaging target; defaults to
         the compatibility floor (4.8.0, .NET 8 SDK). See the note in WebDriverBiDi.Analyzers.csproj. -->
    <RoslynVersion Condition="'$(RoslynVersion)' == ''">4.8.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDriverBiDi.Analyzers\WebDriverBiDi.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../WebDriverBiDi.snk" />
  </ItemGroup>
</Project>
