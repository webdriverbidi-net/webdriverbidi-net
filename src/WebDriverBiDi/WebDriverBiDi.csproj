<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enforce that non-nullable members are initialized. CS8618 catches a non-nullable field or
         property (such as a required read-only list on a CommandParameters type) that is left
         uninitialized, which the reflection-based convention tests cannot detect. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8618</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../WebDriverBiDi.snk</AssemblyOriginatorKeyFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>WebDriverBiDi</PackageId>
    <Authors>WebDriverBiDi.NET Committers</Authors>
    <Company>WebDriverBiDi.NET Committers</Company>
    <Title>WebDriver BiDirectional Client Library</Title>
    <Description>A .NET client library for the WebDriver BiDi protocol.</Description>
    <PackageTags>webdriver;bidi;browser-automation;webdriver-bidi;automation</PackageTags>
    <PackageProjectUrl>https://github.com/webdriverbidi-net/webdriverbidi-net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/webdriverbidi-net/webdriverbidi-net</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.11" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../../.stylecop.json" />
    <AdditionalFiles Include="../../WebDriverBiDi.snk" />
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>
