<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WebDriverBiDi.Compatibility.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <PackageReference Include="PinchHitter" Version="0.0.19" />
  </ItemGroup>

  <!-- These tests build and run a separate consumer application out of process; they do not
       reference the library themselves, which is the point. That application pins its own
       reference to the exact build under test (here, netstandard2.0), so a ProjectReference from
       this project would only obscure which build is actually being exercised. -->

  <!-- Process plumbing shared with the integration test project, which drives the same kind of
       out-of-process application against a real browser. -->
  <ItemGroup>
    <ProjectReference Include="..\WebDriverBiDi.TestUtilities\WebDriverBiDi.TestUtilities.csproj" />

    <!-- Build the pipe-peer application, and copy it into this project's output so the netstandard2.0
         smoke application can be handed its path and launch it to exercise the PipeConnection round
         trip. ReferenceOutputAssembly=false: this project only needs the peer built and copied, not
         referenced as an assembly. -->
    <ProjectReference Include="..\WebDriverBiDi.NamedPipeTestApplication\WebDriverBiDi.NamedPipeTestApplication.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- Copy the pipe-peer application next to this test assembly (see the None items in
         WebDriverBiDi.Tests.csproj for the same mechanism). -->
    <None Include="..\WebDriverBiDi.NamedPipeTestApplication\bin\$(Configuration)\net10.0\WebDriverBiDi.NamedPipeTestApplication.dll">
      <Link>TestApplications\WebDriverBiDi.NamedPipeTestApplication.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\WebDriverBiDi.NamedPipeTestApplication\bin\$(Configuration)\net10.0\WebDriverBiDi.NamedPipeTestApplication.runtimeconfig.json">
      <Link>TestApplications\WebDriverBiDi.NamedPipeTestApplication.runtimeconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
