{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Dramaturge.dll"
          ],
          "src": "../src/Dramaturge/bin/Release/netstandard2.0"
        },
        {
          "files": [
            "Dramaturge.Browsers.dll"
          ],
          "src": "../src/Dramaturge.Browsers/bin/Release/netstandard2.0"
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "namespaceLayout": "flattened",
      "properties": {
        "TargetFramework": "netstandard2.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "README.md"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "title": "Dramaturge Documentation",
      "description": "Documentation for Dramaturge, browser automation for .NET built on WebDriver BiDi",
      "author": "WebDriverBiDi.NET Committers",
      "copyright": "Copyright (c) 2026 WebDriverBiDi.NET Committers. All rights reserved."
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "templates/dramaturge"
    ],
    "postProcessors": [],
    "noLangKeyword": false,
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
