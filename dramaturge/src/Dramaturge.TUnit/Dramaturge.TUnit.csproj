<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <RootNamespace>Dramaturge.TUnit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../Dramaturge.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Dramaturge.TUnit</PackageId>
    <Version>0.0.1</Version>
    <Authors>WebDriverBiDi.NET Committers</Authors>
    <Company>WebDriverBiDi.NET Committers</Company>
    <Title>Dramaturge - TUnit</Title>
    <Description>Base classes for TUnit tests that use Dramaturge: a browser launched once per test assembly, an isolated browser and page for each test, and screenshots of a failed test's pages.</Description>
    <PackageTags>dramaturge;webdriver;bidi;browser-automation;testing;tunit</PackageTags>
    <PackageProjectUrl>https://webdriverbidi-net.github.io/dramaturge/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/webdriverbidi-net/dramaturge</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dramaturge/Dramaturge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" Version="1.6.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Dramaturge.Testing.Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <AdditionalFiles Include="../../.stylecop.json" Link=".stylecop.json" />
    <AdditionalFiles Include="../../Dramaturge.snk" />
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <!-- Code TUnit's source generator writes calls the internals of the TUnit version it was built with, which change
       between versions, so the package uses only TUnit's interfaces and takes none. -->
  <Target Name="RemoveTUnitSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'TUnit.Core.SourceGenerator'" />
    </ItemGroup>
  </Target>

</Project>
