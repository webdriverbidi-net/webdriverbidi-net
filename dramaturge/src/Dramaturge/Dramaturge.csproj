<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <RootNamespace>Dramaturge</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../Dramaturge.snk</AssemblyOriginatorKeyFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- docfx reads the API from the netstandard2.0 build, and resolves its references (such as Microsoft.Bcl.AsyncInterfaces)
       only from files beside it. Packing is unaffected. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Dramaturge</PackageId>
    <!-- Shared by the three Dramaturge packages; a release sets it from its tag. -->
    <Version>0.0.1</Version>
    <Authors>WebDriverBiDi.NET Committers</Authors>
    <Company>WebDriverBiDi.NET Committers</Company>
    <Title>Dramaturge</Title>
    <Description>A high-level browser automation API with automatic waiting, built on WebDriver BiDi with the WebDriverBiDi .NET library.</Description>
    <PackageTags>dramaturge;webdriver;bidi;browser-automation;testing;auto-wait</PackageTags>
    <PackageProjectUrl>https://webdriverbidi-net.github.io/dramaturge/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/webdriverbidi-net/dramaturge</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink maps only the sources in source control; the SDK generates others (AssemblyInfo,
         GlobalUsings). Embedding them puts every source a debugger may ask for in the symbol package. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/WebDriverBiDi/WebDriverBiDi.csproj" />
    <ProjectReference Include="../Dramaturge.Browsers/Dramaturge.Browsers.csproj" />
    <ProjectReference Include="../../../src/WebDriverBiDi.Extensions/WebDriverBiDi.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../.stylecop.json" Link=".stylecop.json" />
    <AdditionalFiles Include="../../Dramaturge.snk" />
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ProjectDir)../../third_party/acquiescence/acquiescence.browser.js">
      <Visible>False</Visible>
      <LogicalName>acquiescence-library</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts/page-actions.js">
      <LogicalName>page-actions</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts/element-state.js">
      <LogicalName>element-state</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts/aria-snapshot.js">
      <LogicalName>aria-snapshot</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts/dom-snapshot.js">
      <LogicalName>dom-snapshot</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
